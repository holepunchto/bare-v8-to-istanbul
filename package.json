{
  "name": "bare-v8-to-istanbul",
  "version": "1.0.3",
  "description": "Wrapper for v8-to-istanbul that works with Bare",
  "license": "Apache-2.0",
  "author": "Holepunch",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte"
  },
  "dependencies": {
    "bare-assert": "^1.2.0",
    "bare-fs": "^4.8.1",
    "bare-module": "^6.4.0",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "bare-url": "^2.5.4",
    "bare-utils": "^1.6.0",
    "v8-to-istanbul": "^9.3.0",
    "which-runtime": "^1.4.0"
  },
  "imports": {
    "assert": {
      "bare": "bare-assert",
      "default": "assert"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "module": {
      "bare": "bare-module",
      "default": "module"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    },
    "util": {
      "bare": "bare-utils",
      "default": "util"
    }
  },
  "devDependencies": {
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0"
  }
}
